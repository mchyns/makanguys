# MakanGuys Environment Variables Template
# Salin file ini menjadi .env.local untuk penggunaan lokal

# 1. URL Aplikasi
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Supabase Configuration (Dapatkan dari Project Settings > API di dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Map Provider (MapLibre GL JS vector tiles)
# Default menggunakan OpenFreeMap Bright Style (gratis dan tanpa API key)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright

# 4. Keamanan Panel Admin (/admin)
# Password untuk login moderator di /admin
ADMIN_PASSWORD=makanguysadmin2026
# Secret acak untuk verifikasi cryptographic session cookie (minimal 32 karakter)
ADMIN_SESSION_SECRET=makanguys_super_secure_session_secret_key_32_chars_min

# 5. Integrasi Opsional (Anti-Spam & Rate Limiting Eksternal)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
